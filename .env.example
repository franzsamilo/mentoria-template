# ============================================================
# GoHighLevel (GHL) configuration
# ============================================================
# Pick ONE of two paths to send leads to GHL:
#
#   (a) DIRECT API — set GHL_API_TOKEN + GHL_LOCATION_ID
#   (b) WORKFLOW WEBHOOK — set GHL_WEBHOOK_URL (and ignore the rest)
#
# If neither is set the API route logs the lead and returns ok.
# ------------------------------------------------------------

# (a) Direct GHL Contacts API
# Get the token at: Settings > Private Integrations > Create
# Required scopes: contacts.write contacts.readonly
GHL_API_TOKEN=
# Settings > Business Profile > Location ID
GHL_LOCATION_ID=

# (b) Webhook trigger from a GHL Workflow
# Workflows > New Workflow > Trigger: Inbound Webhook
GHL_WEBHOOK_URL=

# ============================================================
# Custom field IDs
# ============================================================
# In GHL: Settings > Custom Fields > click a field > copy "ID".
# Leave blank to skip the field — the API route omits empties.
# Field names below are suggestions; the keys can be anything.
# ------------------------------------------------------------

GHL_FIELD_SOURCE_SECTION=
GHL_FIELD_PAGE_URL=
GHL_FIELD_REFERRER=
GHL_FIELD_UTM_SOURCE=
GHL_FIELD_UTM_MEDIUM=
GHL_FIELD_UTM_CAMPAIGN=
GHL_FIELD_UTM_TERM=
GHL_FIELD_UTM_CONTENT=
GHL_FIELD_CHILD_AGE=
GHL_FIELD_CHILD_NAME=
GHL_FIELD_PARENT_ROLE=

# ============================================================
# Tags — comma-separated, applied to every contact.
# Per-touchpoint tags (e.g. mentoria-hero) are added automatically.
# ============================================================
GHL_BASE_TAGS=mentoria-landing
